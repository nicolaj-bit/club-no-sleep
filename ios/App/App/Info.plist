<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Club No Sleep</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Club No Sleep bruger din placering til at vise babyvenlige caféer og fagpersoner i nærheden af dig.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Club No Sleep beder om adgang til din kalender for at kunne tilføje aftaler og påmindelser direkte i den.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Club No Sleep beder om adgang til din kalender for at kunne tilføje aftaler og påmindelser direkte i den.</string>
	<key>NSCameraUsageDescription</key>
	<string>Club No Sleep bruger kameraet til at tage billeder af dine milepæle og minder.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Club No Sleep bruger mikrofonen til optagelse af videoer af dine milepæle.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Club No Sleep bruger dit fotoalbum, så du kan vælge billeder til dine milepæle.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Club No Sleep gemmer dine milepælsbilleder i dine egne billeder, når du beder om det.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Vi bruger det kun til at se, om vores annoncer virker. Du kan sige nej, og appen fungerer præcis som før.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
		Metas app-id og client token.

		$(FACEBOOK_APP_ID) og $(FACEBOOK_CLIENT_TOKEN) er build-indstillinger,
		som ios/App/ci_scripts/inject_meta_config.sh skriver ind fra
		miljøvariabler ved build. Værdierne står altså aldrig i repoet.

		autoLogAppEventsEnabled og advertiserIDCollectionEnabled står med
		vilje IKKE her. De styres i koden — se MetaEventsController.swift —
		fordi de skal kunne skiftes igen, når brugeren har svaret på
		sporingsdialogen.
	-->
	<key>FacebookAppID</key>
	<string>$(FACEBOOK_APP_ID)</string>
	<key>FacebookClientToken</key>
	<string>$(FACEBOOK_CLIENT_TOKEN)</string>
	<key>FacebookDisplayName</key>
	<string>Club No Sleep</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fbapi</string>
		<string>fb-messenger-share-api</string>
		<string>fbauth2</string>
		<string>fbshareextension</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>clubnosleep</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb$(FACEBOOK_APP_ID)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>