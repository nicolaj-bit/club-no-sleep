{
  "name": "Kalender motor (daglig)",
  "description": "Sender alle kalendernotifikationer: graviditetsuger, aldersmilep\u00e6le, tigerspring, milep\u00e6le og brugerens egne aftaler. K\u00f8rer dagligt kl. 09:00 dansk tid. Kalder den f\u00e6lles notificationEngine (standard t\u00f8r-tilstand, ingen afsendelse f\u00f8r aktivering).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Europe/Copenhagen",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "kalender_motor_daglig",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificationEngine",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}