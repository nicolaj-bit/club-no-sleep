{
  "name": "BlogPost",
  "properties": {
    "author_image": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "category": {
      "description": "Kategori",
      "type": "string"
    },
    "content": {
      "description": "Fuldt indhold (markdown)",
      "type": "string"
    },
    "content_en": {
      "description": "Engelsk indhold, hentet fra lalatoto.dk/en. Er det tomt, vises det danske.",
      "type": "string"
    },
    "excerpt": {
      "description": "Kort uddrag",
      "type": "string"
    },
    "excerpt_en": {
      "description": "Engelsk uddrag. Er det tomt, vises det danske.",
      "type": "string"
    },
    "featured_image": {
      "description": "Hovedbillede URL",
      "type": "string"
    },
    "published": {
      "default": true,
      "type": "boolean"
    },
    "published_date": {
      "format": "date",
      "type": "string"
    },
    "slug": {
      "description": "URL-venlig titel",
      "type": "string"
    },
    "tags": {
      "description": "Tags",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "description": "Blogtitel",
      "type": "string"
    },
    "title_en": {
      "description": "Engelsk titel, hentet fra lalatoto.dk/en. Er den tom, vises den danske.",
      "type": "string"
    }
  },
  "required": [
    "title",
    "content"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}