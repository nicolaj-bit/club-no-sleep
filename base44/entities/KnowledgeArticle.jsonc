{
  "name": "KnowledgeArticle",
  "properties": {
    "category": {
      "description": "Kategori",
      "type": "string"
    },
    "content": {
      "description": "Indhold (HTML)",
      "type": "string"
    },
    "content_en": {
      "description": "Engelsk indhold (HTML). Er det tomt, vises det danske.",
      "type": "string"
    },
    "excerpt": {
      "description": "Kort beskrivelse (vises i lister)",
      "type": "string"
    },
    "excerpt_en": {
      "description": "Engelsk kort beskrivelse. Er den tom, vises den danske.",
      "type": "string"
    },
    "is_faq": {
      "default": false,
      "description": "Er dette en FAQ?",
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "description": "Sorteringsr\u00e6kkef\u00f8lge",
      "type": "number"
    },
    "tags": {
      "description": "Tags \u2014 fx tigerspring-1 for at knytte til tigerspring nr. 1",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "description": "Artikeltitel",
      "type": "string"
    },
    "title_en": {
      "description": "Engelsk titel. Er den tom, vises den danske.",
      "type": "string"
    }
  },
  "required": [
    "title",
    "content",
    "category"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}