{
  "name": "MilestoneFrame",
  "properties": {
    "accent_color": {
      "description": "Accentfarve til sticker-ring (hex)",
      "type": "string"
    },
    "bg_color": {
      "description": "Baggrundfarve (hex, fx '#F5EFE6')",
      "type": "string"
    },
    "category": {
      "description": "Kategori",
      "enum": [
        "Graviditet",
        "Baby",
        "\u00d8jeblikke"
      ],
      "type": "string"
    },
    "description": {
      "description": "Valgfri beskrivelse",
      "maxLength": 1000,
      "type": "string"
    },
    "emoji": {
      "description": "Emoji til stickeren",
      "type": "string"
    },
    "headline": {
      "description": "Stor tekst p\u00e5 stickeren",
      "type": "string"
    },
    "headline_en": {
      "description": "Engelsk hovedtekst p\u00e5 stickeren. Er den tom, vises den danske.",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "description": "Om milep\u00e6len vises",
      "type": "boolean"
    },
    "label": {
      "description": "Kort label (fx 'Uge 12', '1 \u00e5r')",
      "type": "string"
    },
    "label_en": {
      "description": "Engelsk label. Er den tom, vises den danske.",
      "type": "string"
    },
    "milestone_id": {
      "description": "Unik ID (fx 'preg-12', 'baby-1y')",
      "type": "string"
    },
    "order": {
      "default": 0,
      "description": "Sorteringsr\u00e6kkef\u00f8lge",
      "type": "number"
    },
    "sticker_image": {
      "description": "Valgfrit brugerdefineret sticker-billede (URL)",
      "type": "string"
    },
    "subline": {
      "description": "Lille tekst under headline",
      "type": "string"
    },
    "subline_en": {
      "description": "Engelsk undertekst p\u00e5 stickeren. Er den tom, vises den danske.",
      "type": "string"
    },
    "text_color": {
      "description": "Tekstfarve (hex)",
      "type": "string"
    }
  },
  "required": [
    "milestone_id",
    "category",
    "label",
    "headline"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}