{
  "name": "PushNotificationRule",
  "properties": {
    "description": {
      "description": "Intern note",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "description": "Er reglen aktiv",
      "type": "boolean"
    },
    "last_triggered_at": {
      "description": "Sidst udsendt (ISO timestamp)",
      "type": "string"
    },
    "message": {
      "description": "Notifikationens besked",
      "type": "string"
    },
    "message_en": {
      "description": "Engelsk besked. Er den tom, bruges den danske.",
      "type": "string"
    },
    "name": {
      "description": "Navn p\u00e5 reglen (intern brug)",
      "type": "string"
    },
    "schedule_days": {
      "description": "Ugedage (0=s\u00f8ndag, 1=mandag ... 6=l\u00f8rdag). Tom = alle dage",
      "items": {
        "type": "number"
      },
      "type": "array"
    },
    "schedule_time": {
      "description": "Tidspunkt for daglig udsendelse (HH:mm), fx '09:00'",
      "type": "string"
    },
    "target_segment": {
      "default": "all",
      "description": "Hvem skal modtage",
      "enum": [
        "all",
        "moms",
        "dads"
      ],
      "type": "string"
    },
    "title": {
      "description": "Notifikationens titel",
      "type": "string"
    },
    "title_en": {
      "description": "Engelsk titel. Er den tom, bruges den danske.",
      "type": "string"
    },
    "trigger_type": {
      "description": "Hvorn\u00e5r/hvad trigger notifikationen",
      "enum": [
        "manual",
        "scheduled",
        "calendar_event",
        "new_blog",
        "new_question",
        "sleep_log"
      ],
      "type": "string"
    },
    "url": {
      "description": "Hvor skal brugeren hen ved klik (fx /Knowledge)",
      "type": "string"
    }
  },
  "required": [
    "name",
    "trigger_type",
    "title",
    "message"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}