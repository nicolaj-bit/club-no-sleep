{
  "name": "SleepLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Ejerens email"
    },
    "child_id": {
      "type": "string",
      "description": "Reference til Child entity"
    },
    "profile_id": {
      "type": "string",
      "description": "Reference til UserProfile"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Dato for session (afledt af session_start)"
    },
    "child_age_months": {
      "type": "number",
      "description": "Barnets alder i m\u00e5neder"
    },
    "session_status": {
      "type": "string",
      "enum": [
        "active_sleep",
        "active_awake",
        "completed"
      ],
      "description": "Sessionens status: aktiv sovende, aktiv v\u00e5gen, eller afsluttet"
    },
    "sleep_type": {
      "type": "string",
      "enum": [
        "nap",
        "night"
      ],
      "default": "night",
      "description": "S\u00f8vntype: lur eller nattes\u00f8vn. Eksisterende sessioner uden type behandles som nattes\u00f8vn."
    },
    "session_start": {
      "type": "string",
      "format": "date-time",
      "description": "Sessionens start-tidspunkt"
    },
    "session_end": {
      "type": "string",
      "format": "date-time",
      "description": "Sessionens slut-tidspunkt (null mens aktiv)"
    },
    "periods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "sleep",
              "awake"
            ]
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "null for den \u00e5bne/nuv\u00e6rende periode"
          }
        }
      },
      "description": "Liste af s\u00f8vn- og v\u00e5gen-perioder. Den sidste uden 'end' er den nuv\u00e6rende."
    },
    "created_by_email": {
      "type": "string",
      "description": "Email p\u00e5 den bruger der oprettede eller \u00e6ndrede sessionen"
    },
    "parent_note": {
      "type": "string",
      "description": "Noter fra for\u00e6lder"
    },
    "bedtime": {
      "type": "string",
      "description": "Legacy: sengetid (HH:mm)"
    },
    "sleep_time": {
      "type": "string",
      "description": "Legacy: faldt i s\u00f8vn (HH:mm)"
    },
    "wake_time": {
      "type": "string",
      "description": "Legacy: v\u00e5gnede (HH:mm)"
    },
    "minutes_to_sleep": {
      "type": "number",
      "description": "Legacy: minutter til at falde i s\u00f8vn"
    },
    "night_wakings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        }
      },
      "description": "Legacy: natlige opv\u00e5gninger"
    },
    "naps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      },
      "description": "Legacy: lure"
    },
    "sleep_method": {
      "type": "string",
      "enum": [
        "selv",
        "amning",
        "flaske",
        "vugning",
        "barnevogn",
        "med_for\u00e6lder"
      ],
      "description": "Legacy: hvordan barnet faldt i s\u00f8vn"
    },
    "bedtime_mood": {
      "type": "string",
      "enum": [
        "frisk",
        "lidt_tr\u00e6t",
        "meget_tr\u00e6t",
        "overtr\u00e6t"
      ],
      "description": "Legacy: hum\u00f8r f\u00f8r sengetid"
    }
  },
  "required": [
    "user_email",
    "date"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "isAuthenticated": true
          }
        }
      ]
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}