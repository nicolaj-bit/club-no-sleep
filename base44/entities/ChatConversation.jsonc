{
  "name": "ChatConversation",
  "type": "object",
  "properties": {
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email adresser p\u00e5 deltagere"
    },
    "participant_usernames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_at": {
      "type": "object",
      "description": "Kort over email -> ISO-tidsstempel for hvorn\u00e5r hver deltager senest l\u00e6ste tr\u00e5den",
      "additionalProperties": {
        "type": "string",
        "format": "date-time"
      }
    },
    "is_group": {
      "type": "boolean",
      "default": false
    },
    "group_name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Valgfri beskrivelse"
    }
  },
  "required": [
    "participants"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "data.participants": "{{user.email}}"
    },
    "update": {
      "data.participants": {
        "$in": [
          "{{user.email}}"
        ]
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}